% AVISPA/HLPSL abstract port of M1 certificate-based ECDHE.
% Scope: secrecy and authentication over the normalized message-flow skeleton.

role initiator(A,B: agent, H: hash_func, SND,RCV: channel(dy))
played_by A
def=
  local State: nat, Na,Nb,K: text
  init State := 0
  transition
    1. State = 0 /\ RCV(start) =|>
       State' := 1 /\ Na' := new() /\
       SND(A.B.Na') /\
       witness(A,B,m1_i_auth,Na')

    2. State = 1 /\ RCV(B.A.Na.Nb') =|>
       State' := 2 /\ K' := H(Na.Nb') /\
       request(A,B,m1_r_auth,Nb') /\
       secret(K',m1_key,{A,B})
end role

role responder(A,B: agent, H: hash_func, SND,RCV: channel(dy))
played_by B
def=
  local State: nat, Na,Nb,K: text
  init State := 0
  transition
    1. State = 0 /\ RCV(A.B.Na') =|>
       State' := 1 /\ Nb' := new() /\ K' := H(Na'.Nb') /\
       SND(B.A.Na'.Nb') /\
       witness(B,A,m1_r_auth,Nb') /\
       request(B,A,m1_i_auth,Na') /\
       secret(K',m1_key,{A,B})
end role

role session(A,B: agent, H: hash_func)
def=
  local SAI,RAI,SBR,RBR: channel(dy)
  composition
    initiator(A,B,H,SAI,RAI) /\ responder(A,B,H,SBR,RBR)
end role

role environment()
def=
  const a,b: agent, h: hash_func, m1_i_auth,m1_r_auth,m1_key: protocol_id
  intruder_knowledge = {a,b,h}
  composition
    session(a,b,h)
end role

goal
  secrecy_of m1_key
  authentication_on m1_i_auth
  authentication_on m1_r_auth
end goal

environment()
