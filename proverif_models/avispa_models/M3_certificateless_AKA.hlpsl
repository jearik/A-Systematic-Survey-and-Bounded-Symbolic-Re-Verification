% AVISPA/HLPSL abstract port of M3 certificateless AKA.
% KGC compromise is represented by a public kgc_material token, so the session
% secret must not depend only on KGC-controlled material.

role initiator(A,B: agent, H: hash_func, SND,RCV: channel(dy))
played_by A
def=
  local State: nat, Na,Nb,K,KGCPub: text
  init State := 0
  transition
    1. State = 0 /\ RCV(start) =|>
       State' := 1 /\ Na' := new() /\ KGCPub' := H(kgc_material) /\
       SND(A.B.KGCPub'.Na') /\
       witness(A,B,m3_i_auth,Na')

    2. State = 1 /\ RCV(B.A.KGCPub.Na.Nb') =|>
       State' := 2 /\ K' := H(Na.Nb'.KGCPub) /\
       request(A,B,m3_r_auth,Nb') /\
       secret(K',m3_key,{A,B})
end role

role responder(A,B: agent, H: hash_func, SND,RCV: channel(dy))
played_by B
def=
  local State: nat, Na,Nb,K,KGCPub: text
  init State := 0
  transition
    1. State = 0 /\ RCV(A.B.KGCPub'.Na') =|>
       State' := 1 /\ Nb' := new() /\ K' := H(Na'.Nb'.KGCPub') /\
       SND(B.A.KGCPub'.Na'.Nb') /\
       witness(B,A,m3_r_auth,Nb') /\
       request(B,A,m3_i_auth,Na') /\
       secret(K',m3_key,{A,B})
end role

role session(A,B: agent, H: hash_func)
def=
  local SAI,RAI,SBR,RBR: channel(dy)
  composition
    initiator(A,B,H,SAI,RAI) /\ responder(A,B,H,SBR,RBR)
end role

role environment()
def=
  const a,b: agent, h: hash_func, kgc_material: text,
        m3_i_auth,m3_r_auth,m3_key: protocol_id
  intruder_knowledge = {a,b,h,kgc_material}
  composition
    session(a,b,h)
end role

goal
  secrecy_of m3_key
  authentication_on m3_i_auth
  authentication_on m3_r_auth
end goal

environment()
